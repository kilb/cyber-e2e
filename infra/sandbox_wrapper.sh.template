#!/bin/bash
# Template for an unprivileged bwrap sandbox for blind/isolated e2e agent runs.
# Adapt the masked paths below to this repo's actual layout once it exists --
# this is a STARTING POINT carried over from the sibling PoC-gen project
# (../RepoRepairGym on blk.so, ~/rrg-newcases/blind_sandbox_wrapper.sh), not a
# finished config. In e2e, the agent is given NO description/hints at all, so
# there is less of an "answer leak" risk than in the sibling project -- but you
# still want to mask: other cases' material, the scorer/harness source itself,
# and the project's own ground-truth reference PoC/patch.
#
# IMPORTANT, learned the hard way in the sibling project: without --unshare-pid,
# `ps`/`pkill` inside one sandboxed run can see and kill OTHER PARALLEL runs'
# processes if they share a process name (e.g. two parallel instances of the
# same case both starting a server on the same port -- one agent's cleanup
# `pkill` nukes the other's server, which cascades into a false "run crashed"
# failure that has nothing to do with whether the model could solve the task).
# Keep --unshare-pid in any sandbox used for >1 parallel instance of the same
# case id.
exec bwrap \
  --bind / / \
  --dev /dev \
  --unshare-pid \
  --proc /proc \
  --tmpfs /PLACEHOLDER/cases \
  --ro-bind /dev/null /PLACEHOLDER/scorer_or_harness_entrypoint.py \
  -- "$@"
